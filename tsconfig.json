{
	// While everything is local: the core's editor config and its `~/` alias
	// from the neighbouring checkout, like the file: links in package.json.
	// Once @amxts/core is a package this extends it instead.
	"extends": "../../ts2pawn/as/tsconfig.json",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"~/*": ["../../ts2pawn/as/*"]
		},
		"noEmit": true
	},
	"include": ["src/**/*.ts"]
}
