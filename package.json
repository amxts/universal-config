{
	"name": "@amxts/universal-config",
	"type": "module",
	"version": "1.6.1",
	"description": "INI configs for amxts plugins: sections, typed values, paths - and the cfg_* natives for Pawn plugins.",
	"author": {
		"name": "kukson777",
		"url": "https://github.com/kukson777"
	},
	"license": "MIT",
	"homepage": "https://github.com/amxts/universal-config#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/amxts/universal-config.git"
	},
	"keywords": [
		"amxts-module",
		"amxts-config",
		"amxmodx",
		"counter-strike"
	],
	"exports": {
		".": "./src/index.ts"
	},
	"types": "./src/index.ts",
	"files": [
		"README.md",
		"README.ru.md",
		"include",
		"src"
	],
	"amxts": {
		"module": "src/index.ts",
		"natives": "src/natives.ts",
		"include": "include/universal_config.inc"
	},
	"scripts": {
		"lint": "eslint",
		"lint:fix": "eslint --fix"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.5.1",
		"eslint": "^10.11.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
